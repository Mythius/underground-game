# Snapshot rate is rounded so it divides TICK_RATE evenly.
# Copy to .env and adjust. Real environment variables take precedence over .env.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
TICK_RATE=30
SNAPSHOT_RATE=15
MAX_PLAYERS_PER_ROOM=50
# Comma-separated list; leave empty to allow any origin (dev only).
ALLOWED_ORIGINS=
# Password for saving maps from the in-game map editor. Leave empty to disable saving.
ADMIN_PASSWORD=
